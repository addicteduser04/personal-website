{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/quant", "destination": "/index.html" },
    { "source": "/data-ai", "destination": "/index.html" },
    { "source": "/digital-transformation", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/projects/:slug", "destination": "/index.html" }
  ],
  "headers": [{ "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }]
}
