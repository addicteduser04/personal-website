{
  "cleanUrls": true,
  "redirects": [
    { "source": "/projects", "destination": "/#work", "permanent": true }
  ],
  "rewrites": [
    { "source": "/quant", "destination": "/quant/index.html" },
    { "source": "/data-ai", "destination": "/data-ai/index.html" },
    { "source": "/digital-transformation", "destination": "/digital-transformation/index.html" },
    { "source": "/projects/:slug", "destination": "/projects/:slug/index.html" },
    { "source": "/experience/:slug", "destination": "/experience/:slug/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
